// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// SQLite doesn't support enums, using String with default values
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          String    @default("CLIENT")  // ADMIN | CLIENT
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  events        Event[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Template {
  id          String    @id @default(uuid())
  name        String
  description String?
  eventType   String    // WEDDING | BAPTISM | BIRTHDAY | ANNIVERSARY | CORPORATE
  thumbnail   String
  previewUrl  String?
  
  // Design configuration (stored as JSON strings)
  colorScheme String    // JSON: { primary, secondary, accent, background, text }
  layout      String    // JSON: Layout configuration
  sections    String    // JSON: Available sections and their default content
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  events      Event[]
}

model Event {
  id              String      @id @default(uuid())
  userId          String
  templateId      String
  
  // Event details
  eventType       String      // WEDDING | BAPTISM | BIRTHDAY | ANNIVERSARY | CORPORATE
  eventTitle      String
  eventDate       DateTime
  eventLocation   String?
  
  // Customization (stored as JSON string)
  customContent   String      // JSON: All customized content (text, images, colors, etc.)
  publicLink      String      @unique  // Unique public URL slug
  
  // Order info
  orderStatus     String      @default("PENDING")  // PENDING | PAID | ACTIVE | EXPIRED
  paymentDate     DateTime?
  expiryDate      DateTime?
  
  isActive        Boolean     @default(true)
  views           Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        Template    @relation(fields: [templateId], references: [id])
  rsvps           RSVP[]
}

model RSVP {
  id          String      @id @default(uuid())
  eventId     String
  
  // Guest info
  guestName   String
  guestEmail  String?
  guestPhone  String?
  
  // Response
  status      String      // ATTENDING | NOT_ATTENDING | MAYBE
  numberOfGuests Int      @default(1)
  message     String?
  dietaryRestrictions String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id                String   @id @default(uuid())
  siteName          String   @default("Weday")
  siteDescription   String?
  logo              String?
  contactEmail      String?
  contactPhone      String?
  socialLinks       String?  // JSON: { facebook, instagram, twitter, etc }
  
  // Pricing
  packagePrice      Int      @default(999)
  currency          String   @default("MDL")
  
  // Features
  featuresEnabled   String?  // JSON: Which features are enabled
  
  updatedAt         DateTime @updatedAt
}
